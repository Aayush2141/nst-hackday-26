# Local Ollama model name — change this if you pulled a different tag.
OLLAMA_MODEL=gemma3:4b
OLLAMA_HOST=http://localhost:11434
OLLAMA_TIMEOUT=45

# data.gov.in API key (free). Leave empty to use SAMPLE demo data.
DATA_GOV_API_KEY=

# Agmarknet daily prices resource id on data.gov.in.
# MUST be verified — catalogue ids can change.
# Default is the commonly cited "Current Daily Price of Various Commodities
# from Various Markets (Mandi)" resource:
DATA_GOV_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
